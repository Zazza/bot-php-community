# php-bot — переменные окружения.
# Скопируй в .env и заполни. Подробно — в README.md.

# ============ ОБЯЗАТЕЛЬНО ============

# Telegram
PHPBOT_TG_TOKEN=                      # от @BotFather, напр. 1234567890:ABC-Def...
PHPBOT_ADMIN_IDS=123456789,987654321  # tg user id админов через запятую (узнать через @userinfobot)
PHPBOT_CHAT_ID=-1001234567890         # id целевого чата через запятую (узнать через @userinfobot)

# LLM / Embeddings (VseLLM, OpenAI-compatible)
PHPBOT_LLM_API_KEY=                   # ключ с api.vsellm.ru

# ============ ОПЦИОНАЛЬНО (с дефолтами) ============

PHPBOT_LLM_URL=https://api.vsellm.ru/v1
PHPBOT_LLM_MODEL=google/gemini-2.5-flash
PHPBOT_EMBED_MODEL=text-embedding-3-small
PHPBOT_EMBED_DIM=1536                 # должно совпадать с vector(N) в миграции

PHPBOT_QUIET_THRESHOLD=20             # мин. сообщений за 24ч, иначе «тихо»
PHPBOT_TOPIC_CRON=0 12,20 * * *       # cron проверки тишины (5 полей: min hour dom mon dow)
PHPBOT_NEWCOMER_TIMEOUT=5m            # сколько ждать ответ от новичка

# PHPBOT_DB_URL — только для запуска бинарником (вне Docker).
# В docker compose подставляется автоматически из POSTGRES_* ниже.
# PHPBOT_DB_URL=postgres://phpbot:phpbot@localhost:5432/php_bot?sslmode=disable

# ============ ТОЛЬКО ДЛЯ DOCKER COMPOSE ============

POSTGRES_USER=phpbot
POSTGRES_PASSWORD=смените_на_длинный_пароль
POSTGRES_DB=php_bot
TZ=Europe/Moscow                      # таймзона для cron и логов

# PHPBOT_LOG_PATH — внутри контейнера (/app/logs/bot.log).
# При запуске бинарником укажи свой путь, напр. /srv/php-bot/logs/bot.log.
# PHPBOT_LOG_PATH=
